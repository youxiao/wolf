#!/usr/bin/env python3
"""Project-local workaround for Xcode 27 lipo's multi-arch verify parsing.
Flutter 3.27 passes both architectures in one -verify_arch call. Verify them
individually, preserving Apple's lipo for every other operation. No SDK edits.
"""
import os, subprocess, sys
args = sys.argv[1:]
if '-verify_arch' in args:
    position = args.index('-verify_arch')
    files, archs = args[:position], args[position + 1:]
    if len(files) == 1 and len(archs) > 1:
        for arch in archs:
            code = subprocess.run(['/usr/bin/lipo', files[0], '-verify_arch', arch]).returncode
            if code: sys.exit(code)
        sys.exit(0)
os.execv('/usr/bin/lipo', ['/usr/bin/lipo', *args])
